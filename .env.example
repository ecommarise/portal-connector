# The Ecommarise Connector — service configuration.
#
# This service is the ONLY component on the public internet. The portal sits on a private
# network and accepts requests from here alone. See docs/ECOMMARISE_CONNECTOR_FEASIBILITY.md §9.

# Public origin of this service. Must be https:// in anything but local development — OAuth 2.1
# requires it, and an issuer on plain HTTP hands every token to anyone on the path.
CONNECTOR_ISSUER=https://connector.example.com
PORT=8787

# Where the portal is, as reachable from THIS host. A private address is the point: if this is
# a public URL, the portal is exposed and the whole arrangement buys nothing.
#
# Must be https:// — the service token travels on every call, and with it anybody can use the
# portal's internal API. http is refused at boot unless the path is an encrypted private tunnel
# (WireGuard, SSH) and you say so with PORTAL_ALLOW_HTTP=true. http://localhost is always fine.
PORTAL_BASE_URL=https://portal.internal.example.com
PORTAL_ALLOW_HTTP=false

# How long one portal call may take, in milliseconds.
PORTAL_TIMEOUT_MS=15000

# Hosts an MCP client may register an https redirect URI on (and their subdomains). Loopback
# http is always allowed. Keep this to Claude: an open list lets anybody register a client that
# sends a user's sign-in, approved on the real consent screen, to their own server.
ALLOWED_REDIRECT_HOSTS=claude.ai,claude.com

# Express "trust proxy". `loopback` trusts a reverse proxy on this host (Caddy, nginx) to report
# the caller's address — what the rate limits count. Set it to the proxy's address if the proxy
# runs elsewhere.
TRUST_PROXY=loopback

# OPTIONAL, and normally left empty.
#
# The connector gets its service token by ENROLLING: an administrator generates a code in the
# portal under Administration → Portal Connector → Settings & Activity → "Connect a connector",
# and pastes it at https://this-connector/setup. This service then generates its own token,
# registers it with the portal and keeps it in DATA_DIR. Nobody copies a secret, and rotating
# it later needs nobody on this host.
#
# Set this only when the setup page cannot be reached — a host still being built, or a recovery
# where the token must change first. An enrolled token always wins over this value.
PORTAL_SERVICE_TOKEN=

# Token lifetimes, in seconds. The defaults are an hour and thirty days.
ACCESS_TOKEN_TTL=3600
REFRESH_TOKEN_TTL=2592000
AUTH_CODE_TTL=60

# How often to ask the portal whose sessions have been ended, in seconds.
#
# This is tidying, not enforcement: the portal refuses a revoked session's calls immediately
# whatever this is set to. What the interval bounds is how long a revoked user's Claude can
# still RECONNECT without a browser — which is the thing that makes a revocation look as
# though it did nothing.
REVOCATION_POLL_SECONDS=60

# Where the token store file lives. Must NOT be a shared or backed-up volume: it holds hashed
# but live credentials, and — once this connector is enrolled — its service token in plaintext,
# which it has to be, since it is presented to the portal on every call.
DATA_DIR=data
